# Anthropic API key. Create one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Any Claude model your key can access.
CLAUDE_MODEL=claude-haiku-4-5

# Optional tuning.
# CLAUDE_TIMEOUT=180
# CLAUDE_MAX_RETRIES=2
# CLAUDE_MAX_TOKENS_CEILING=16000
# CLAUDE_TEMPERATURE=0.85
# MAX_PROMPT_CHARS=4000
# LOG_LEVEL=INFO
# PORT=5000
