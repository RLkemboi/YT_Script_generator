# Hugging Face access token with "Make calls to Inference Providers" permission.
# Create one at https://huggingface.co/settings/tokens
HF_API_KEY=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Any model served by Hugging Face Inference Providers.
HF_MODEL=Qwen/Qwen2.5-72B-Instruct

# OpenAI-compatible chat-completions base URL. The default is the Hugging Face
# router; point this at any other compatible gateway to switch providers.
HF_API_BASE=https://router.huggingface.co/v1

# Optional tuning.
# HF_TIMEOUT=90
# HF_MAX_RETRIES=3
# HF_RETRY_BACKOFF=2
# HF_MAX_TOKENS=2000
# HF_TEMPERATURE=0.85
# HF_JSON_MODE=false
# MAX_PROMPT_CHARS=4000
# LOG_LEVEL=INFO
# PORT=5000
